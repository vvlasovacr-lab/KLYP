{
  "name": "reels-studio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server/index.js",
    "dev": "node --watch --env-file-if-exists=.env server/index.js",
    "worker": "WEB_ENABLED=0 node --env-file-if-exists=.env server/index.js",
    "studio": "remotion studio",
    "render": "remotion render",
    "sfx": "node tools/make-sfx.mjs",
    "e2e": "node --env-file-if-exists=.env tools/e2e.mjs"
  },
  "dependencies": {
    "@fastify/multipart": "^9.0.3",
    "@fastify/static": "^8.1.1",
    "@remotion/cli": "^4.0.506",
    "@remotion/media-utils": "^4.0.506",
    "fastify": "^5.2.1",
    "grammy": "^1.32.0",
    "pg": "^8.13.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "remotion": "^4.0.506"
  }
}
