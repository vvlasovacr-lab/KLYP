{
  "input_dir": "input",
  "output_dir": "output",
  "work_dir": "work",
  "logs_dir": "logs",
  "assets_dir": "assets",
  "profile": "AUTO",
  "video_extensions": [".mp4", ".mov", ".mkv", ".avi", ".webm", ".m4v"],
  "whisper": {
    "model": "medium",
    "device": "cpu",
    "compute_type": "int8",
    "language": "ru",
    "beam_size": 5
  },
  "speech_edit": {
    "enabled": true,
    "min_silence_remove_ms": 650,
    "max_allowed_pause_ms": 420,
    "silence_threshold": 0.58,
    "retained_pause": 0.30,
    "thought_pause_threshold": 0.62,
    "retained_thought_pause": 0.42,
    "remove_fillers": true,
    "filler_words": ["ээ", "эм", "ну", "короче", "как бы", "вот", "типа"],
    "filler_min_gap": 0.18,
    "preserve_speech_rate": false,
    "speech_compression": true,
    "compression_speed": 1.035,
    "min_compress_segment_ms": 900,
    "max_speed": 1.06,
    "calm_speed": 1.035,
    "hook_window_ms": 3000
  },
  "face_tracking": {
    "enabled": true,
    "sample_interval": 0.5,
    "min_confidence": 0.5
  },
  "editorial_quality": {
    "enabled": true,
    "analyze_single_ready_clip": true,
    "sample_step": 0.24,
    "sample_window": 1.2,
    "max_start_search_seconds": 14.0,
    "alternate_take_search_seconds": 10.0,
    "max_auto_lead_trim_seconds": 1.5,
    "max_visual_lead_trim_seconds": 3.2,
    "min_start_readiness": 0.62,
    "min_readiness_improvement": 0.12,
    "min_editorial_confidence": 0.66,
    "tail_padding_seconds": 0.14,
    "max_end_trim_seconds": 1.6,
    "detector_max_width": 720,
    "internal_enabled": true,
    "internal_sample_step": 0.42,
    "sustained_bad_min_seconds": 1.25,
    "sustained_downward_min_seconds": 1.1,
    "internal_gaze_threshold": 0.24,
    "downward_gaze_threshold": 0.58,
    "min_internal_performance": 0.52,
    "min_take_similarity": 0.74,
    "min_take_performance_gain": 0.14,
    "min_replacement_confidence": 0.72,
    "min_safe_internal_cut_seconds": 0.7,
    "min_kept_shot_seconds": 0.85,
    "min_jump_cut_gap_seconds": 0.65,
    "max_internal_actions": 8,
    "semantic_duplicate_enabled": true,
    "semantic_duplicate_threshold": 0.8,
    "semantic_duplicate_review_threshold": 0.68,
    "semantic_duplicate_min_keep_seconds": 0.85
  },
  "text_composition": {
    "horizontal_margin": 92,
    "left_margin": 104,
    "right_margin": 150,
    "top_margin": 96,
    "bottom_margin": 300,
    "animation_padding": 34,
    "minimum_side_width": 330,
    "minimum_font_scale": 0.78,
    "minimum_display_font_scale": 0.5,
    "face_safety_padding": 44,
    "camera_safety_padding": 24,
    "maximum_side_lines": 2,
    "maximum_normal_lines": 2,
    "maximum_hero_lines": 3,
    "minimum_body_font_px": 48,
    "minimum_display_font_px": 62,
    "body_stroke_ratio": 0.05,
    "display_stroke_ratio": 0.044,
    "minimum_stroke_px": 2.0,
    "maximum_stroke_px": 6.0,
    "maximum_body_overshoot": 1.04,
    "maximum_accent_overshoot": 1.18,
    "maximum_display_overshoot": 1.16,
    "minimum_readability_score": 0.7
  },
  "audio_mastering": {
    "enabled": true,
    "target_lufs": -14.0,
    "true_peak": -1.4,
    "loudness_range": 7.0,
    "noise_reduction": 0.15,
    "voice_gain": 1.0,
    "noise_reduction_strength": 0.15,
    "compression_ratio": 3.0,
    "limiter_threshold": -1.5,
    "music_volume": 0.18,
    "ducking_amount": 0.65,
    "compressor": true,
    "music_ducking": true
  },
  "subtitles": {
    "max_chars_per_line": 42,
    "font_name": "Arial",
    "font_families": ["Bahnschrift Condensed", "Montserrat ExtraBold", "Montserrat Black", "Bahnschrift", "Arial"],
    "hero_font_families": ["Anton", "Impact", "Arial Black", "Arial"],
    "font_size": 64,
    "hero_font_size": 112,
    "accent_scale": 1.25,
    "outline": 4,
    "shadow": 4,
    "line_spacing": 6,
    "margin_vertical": 60
  },
  "render": {
    "ffmpeg": "ffmpeg",
    "video_codec": "libx264",
    "audio_codec": "aac",
    "preset": "medium",
    "crf": 20,
    "zoom_enabled": true,
    "output_fps": 30
  },
  "remotion": {
    "project_dir": "remotion",
    "width": 1080,
    "height": 1920,
    "fps": 30,
    "codec": "h264",
    "crf": 18,
    "sfx_min_gap": 0.35,
    "camera_drift": 0.004,
    "renderer_mode": "hybrid"
  }
}
