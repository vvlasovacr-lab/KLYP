# ─────────────────────────────────────────────────────────────
#  Reels Studio — переменные окружения
#  Скопируй в .env для локального запуска, а на Railway впиши
#  во вкладку Variables. Обязательные помечены (!).
# ─────────────────────────────────────────────────────────────

# (!) Токен бота от @BotFather
BOT_TOKEN=1234567890:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Юзернейм бота без @. Нужен для реферальных ссылок.
# Если не задать — подставится автоматически при старте.
BOT_USERNAME=reelsstudio_bot

# polling для одного инстанса, webhook — если инстансов несколько
BOT_MODE=polling
BOT_WEBHOOK_SECRET=придумай-любую-строку

# (!) Подключение к Postgres.
# На Railway: добавь плагин Postgres и вставь сюда ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgresql://user:pass@localhost:5432/reels

# Публичный адрес сервиса. На Railway подставляется сам из
# RAILWAY_PUBLIC_DOMAIN — тогда эту строку можно не задавать.
# Локально для теста мини-аппа нужен https-туннель (ngrok/cloudflared).
PUBLIC_URL=https://reels-studio-production.up.railway.app

PORT=3000

# Твой Telegram id — даёт админские права. Узнать: @userinfobot
ADMIN_IDS=123456789

# ── Хранилище ────────────────────────────────────────────────
# На Railway примонтируй Volume на /data и укажи его здесь,
# иначе загруженные видео пропадут при первом же редеплое.
STORAGE_DIR=/data
MAX_UPLOAD_MB=2048

# Потолок длительности исходника, секунд. Рилс — короткий формат,
# а время рендера растёт линейно: получасовая лекция заняла бы весь
# воркер на час и списала бы один ролик из пакета.
MAX_DURATION_SEC=180

# Сколько дней держать исходник клиента после успешного монтажа.
# Исходник нужен только для пересборки с правками — это окно правок.
# 0 = удалять сразу после монтажа (правки станут невозможны).
SOURCE_KEEP_DAYS=2

# Сколько дней лежит готовый ролик. Дальше файл удаляется, карточка
# в студии остаётся с пометкой «срок хранения истёк».
OUTPUT_KEEP_DAYS=30

# Как часто уборщик проходит по диску, минут
STORAGE_SWEEP_MIN=60

# ── Монтажный движок ─────────────────────────────────────────
# Движок лежит в engine/ и написан на Python: он распознаёт речь,
# режет паузы, раскладывает монтаж и зовёт Remotion.
# Пусто — берётся engine/.venv, иначе python3 из PATH.
PYTHON_BIN=

# ── Рендер ───────────────────────────────────────────────────
# Один ролик за раз: рендер и так забирает все ядра.
RENDER_CONCURRENCY=1
RENDER_TIMEOUT_MIN=30
# Окно защиты от двойного нажатия, секунд. В это окно второй запрос
# без ключа идемпотентности отклоняется, а не списывает второй ролик.
CREATE_COOLDOWN_SEC=15
# Черновик 480p — доля кредита и масштаб кадра
PREVIEW_COST=0.3
PREVIEW_SCALE=0.45

# ── Пакеты ───────────────────────────────────────────────────
# Сколько дней живёт купленный пакет
PACKAGE_DAYS=90
# Бонус пригласившему, начисляется после оплаты приглашённого
REFERRAL_BONUS=10

# ── Касса Lava.top ───────────────────────────────────────────
# Без ключа оплата работает в тестовом режиме: ссылка ведёт на
# страницу-заглушку, которая начисляет ролики без списания денег.
LAVA_API_KEY=
LAVA_INVOICE_URL=https://gate.lava.top/api/v2/invoice
LAVA_WEBHOOK_SECRET=

# offerId товаров из личного кабинета Lava — по одному на пакет
LAVA_OFFER_START=
LAVA_OFFER_PRO=
LAVA_OFFER_STUDIO=

# ── Распознавание речи ───────────────────────────────────────
# Без ключа субтитры выйдут ПУСТЫМИ: система найдёт границы реплик
# по паузам, но текста взять будет неоткуда. Стоит копейки за ролик.
#
# Куда идти за ключом:
#   openai — platform.openai.com/api-keys, модель whisper-1
#   groq   — console.groq.com/keys, модель whisper-large-v3-turbo,
#            дешевле и быстрее OpenAI при том же протоколе
#
# auto = «есть ключ → openai, нет → границы по паузам».
# Меняешь провайдера — меняешь эту строку, код не трогаешь.
SPEECH_PROVIDER=auto
SPEECH_API_KEY=
SPEECH_LANG=ru

# Ниже — только для своего сервиса (SPEECH_PROVIDER=custom) или чтобы
# перебить пресет. Пустые строки означают «взять из пресета».
SPEECH_URL=
SPEECH_MODEL=
SPEECH_MAX_AUDIO_MB=
# 0 — если сервис не умеет тайминги по словам (подсветка станет грубее)
SPEECH_WORD_TIMESTAMPS=1

# ── Модель (подключается позже) ──────────────────────────────
# Пока ключа нет, разметку собирает шаблонный плановщик.
# Появится ключ — плановщик переключится сам, код менять не нужно.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# ── Роли процесса ────────────────────────────────────────────
# Для одного сервиса оставь обе включёнными.
# Если выносишь рендер отдельно: на вебе WORKER_ENABLED=0,
# на воркере WEB_ENABLED=0.
WEB_ENABLED=1
WORKER_ENABLED=1

NODE_ENV=production
